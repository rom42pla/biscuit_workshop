---
import "bootstrap/dist/css/bootstrap.min.css";
const {
  title = "Title",
  subtitle = "Some description here.",
  edition = "1st",
  date = "Date",
  time = "Time",
  img = "https://via.placeholder.com/800x600",
  conference_img = "https://via.placeholder.com/800x600",
  kth_img = "",
  paris_saclay_img = "",
  princeton_img = "",
} = Astro.props;
---

<section class="mb-4 container">
  <div class="row align-items-center text-center justify-content-center">
    <div class="col-md-8">
      <h1 class="display-1">{title}</h1>
      <h3>{edition} {subtitle}</h3>
      <div style="display: flex; align-items: center; gap: 1rem;">
        <hr style="flex: 1; margin: 0;" />
        <h4 style="margin: 0; white-space: nowrap;">{date}</h4>
        <hr style="flex: 1; margin: 0;" />
        <h4 style="margin: 0; white-space: nowrap;">{time}</h4>
        <hr style="flex: 1; margin: 0;" />
      </div>
    </div>
    <div class="col-6 col-md-4">
      <img src={img.src} class="img-fluid" alt="BISCUIT logo" />
      <img src={conference_img.src} class="img-fluid" alt="Conference logo" />
    </div>
  </div>
  <div class="row align-items-center text-center justify-content-center">
    <div class="col-4">
      <img src={kth_img.src} class="img-fluid logo" alt="KTH logo" />
    </div>
    <div class="col-4">
      <img
        src={paris_saclay_img.src}
        class="img-fluid logo"
        alt="Paris-Saclay logo"
      />
    </div>
    <div class="col-4">
      <img
        src={princeton_img.src}
        class="img-fluid logo"
        alt="Princeton logo"
      />
    </div>
  </div>
</section>

<style>
  .logo {
    height: 80px;
    width: 100%;
    object-fit: contain;
  }
</style>
