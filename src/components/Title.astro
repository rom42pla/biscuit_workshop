---
import 'bootstrap/dist/css/bootstrap.min.css';
const { title = "Title", subtitle = "Some description here.", edition = "1st", img = "https://via.placeholder.com/800x600" } = Astro.props;
---
<section class="container">
  <div class="row align-items-center text-center justify-content-center">
    <div class="col-md-8">
    <h1>{title}</h1>
    <h2>{subtitle}</h2>
    <h3>{edition} edition</h3>
  </div>
  <div class="col-6 col-md-4">
    <img src={img.src} class="img-fluid" alt="BISCUIT logo" />
  </div>
  </div>
  
</section>