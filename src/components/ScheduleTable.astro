---
import { marked } from "marked";

interface Entry {
  hour_start: string;
  hour_end: string;
  emoji: string;
  title: string;
  description?: string;
  gray_bg?: boolean;
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;

const calculateDuration = (start: string, end: string): string => {
  const [startHours, startMinutes] = start.split(':').map(Number);
  const [endHours, endMinutes] = end.split(':').map(Number);
  
  const startTotalMinutes = startHours * 60 + startMinutes;
  const endTotalMinutes = endHours * 60 + endMinutes;
  
  let duration = endTotalMinutes - startTotalMinutes;
  
  // Handle case where end time is next day
  if (duration < 0) {
    duration += 24 * 60;
  }
  
  return `${duration}'`;
};
---

<div class="table-responsive">
  <table class="table table-borderless table-hover align-middle">
    <tbody>
      {
        entries.map((entry) => (
          <tr class={entry.gray_bg ? "table-secondary" : ""}>
            <td class={`${entry.gray_bg ? "" : "bg-transparent"} text-center`}>
              {entry.hour_start}
            </td>

            <td class={`${entry.gray_bg ? "" : "bg-transparent"} text-center`}>
              {entry.hour_end}
            </td>

            <td class={`${entry.gray_bg ? "" : "bg-transparent"} text-center`}>
              {calculateDuration(entry.hour_start, entry.hour_end)}
            </td>

            <td class={`${entry.gray_bg ? "" : "bg-transparent"} text-center`}>
              <span class="me-2">{entry.emoji}</span>
            </td>
            
            <td class={!entry.gray_bg ? "bg-transparent" : ""}>
              {entry.title}
              {entry.description && (
                <div class="small text-muted" set:html={marked.parse(entry.description)} />
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  td :global(.small p),
  td :global(.small ul),
  td :global(.small ol) {
    margin-bottom: 0;
  }

  td :global(.small ul),
  td :global(.small ol) {
    padding-left: 1.1em;
  }
</style>
