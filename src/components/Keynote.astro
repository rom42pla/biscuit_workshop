---
import "bootstrap/dist/css/bootstrap.min.css";

const {
  name = "Name",
  surname = "Surname",
  institution = "Institution",
  img = "https://via.placeholder.com/800x600",
  website = ".",
  papers = ".",
  full = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const slug = `${name}-${surname}`.toLowerCase().replace(/\s+/g, "-");
---

{full ? (
  <div class="col-12 mb-4" id={slug}>
    <div class="card h-100">
      <div class="card-body">
        <div class="row align-items-center">
          <div class="col-4 col-sm-3">
            <div class="ratio ratio-1x1">
              <img
                src={img}
                class="img-fluid object-fit-cover"
                alt="Keynote speaker image"
              />
            </div>
          </div>
          <div class="col-8 col-sm-9 text-start">
            <h3 class="mb-1">{`${name} ${surname}`}</h3>
            <p><i>{institution}</i></p>
            <p>
              <a href={website} target="_blank" style="text-decoration: none">🌐 Website</a>
              {" · "}
              <a href={papers} target="_blank" style="text-decoration: none">📜 Publications</a>
            </p>
          </div>
        </div>
        <div class="mt-3 text-start">
          <slot />
        </div>
      </div>
    </div>
  </div>
) : (
  <div class="col-6 col-lg-3">
    <a href={`${base}/speakers#${slug}`}>
      <div class="ratio ratio-1x1">
        <img
          src={img}
          class="img-fluid object-fit-cover"
          alt="Keynote speaker image"
        />
      </div>
    </a>
    <h3>
      <a href={`${base}/speakers#${slug}`} style="text-decoration: none; color: inherit;">
        {name}<br>{surname}
      </a>
    </h3>
    <p class="keynote-card-institution">
      <a href={`${base}/speakers#${slug}`} style="text-decoration: none; color: inherit;">
        <i>{institution}</i>
      </a>
    </p>
    <p>
      <a href={website} target="_blank" style="text-decoration: none">🌐</a>
      <a href={papers} target="_blank" style="text-decoration: none">📜</a>
    </p>
  </div>
)}

<style>
  .keynote-card-institution {
    min-height: 3em;
  }
</style>
